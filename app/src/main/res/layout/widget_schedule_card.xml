<?xml version="1.0" encoding="utf-8"?>
<!-- 今日课程卡片：左侧课程色条 + 时间 / 课名 / 地点 + 页码角标。
     色条与徽标底色在渲染时按课程上色（见 DeadlineScheduleWidget.card）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_row_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- 左侧课程色条。必须是白名单控件：RemoteViews 不接受裸 View。 -->
    <TextView
        android:id="@+id/card_strip"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:background="#3B82F6" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 课程名 -->
        <TextView
            android:id="@+id/card_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="高等数学"
            android:textColor="#E6000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 时间段 · 节次 -->
        <TextView
            android:id="@+id/card_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="08:00–09:40 · 第1-2节"
            android:textColor="#99000000"
            android:textSize="11sp" />

        <!-- 地点/教师 -->
        <TextView
            android:id="@+id/card_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="教一101 · 张三"
            android:textColor="#99000000"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <!-- 第 n/N 节 -->
        <TextView
            android:id="@+id/card_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/3"
            android:textColor="#99000000"
            android:textSize="10sp" />

        <!-- 上课中 / 已结束 -->
        <TextView
            android:id="@+id/card_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="上课中"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#D9322E"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
