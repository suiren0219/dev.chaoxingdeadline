<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_schedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 标题行：周次 + 刷新 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/s_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="今日课程"
            android:textColor="#E6000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/s_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/widget_refresh"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:text="@string/widget_refresh_icon"
            android:textColor="#99000000"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 更新时间 -->
    <TextView
        android:id="@+id/s_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="更新于 10-03 12:00"
        android:textColor="#99000000"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- 翻页区：一页一张课程卡片，点卡片翻到下一节课。
         ViewFlipper 继承 ViewAnimator（FrameLayout 后代），静态 addView 填充合法；
         StackView 走 AdapterView，addView 会抛 UnsupportedOperationException。 -->
    <ViewFlipper
        android:id="@+id/s_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:animateFirstView="false"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out" />

    <!-- 空态提示 -->
    <TextView
        android:id="@+id/s_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/widget_schedule_empty"
        android:textColor="#99000000"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>

